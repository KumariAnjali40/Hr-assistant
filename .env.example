ENV=dev
LOG_LEVEL=INFO
POSTGRES_PASSWORD=hr
DATABASE_URL=postgresql+asyncpg://hr:hr@postgres:5432/hr
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
OLLAMA_BASE_URL=http://ollama:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text
# Issuer must equal the URL the BROWSER uses to reach Keycloak (it is baked into the token).
# JWKS URL is fetched server-side, so it uses the docker-internal hostname.
OIDC_ISSUER=http://localhost:8080/realms/hr
OIDC_JWKS_URL=http://keycloak:8080/realms/hr/protocol/openid-connect/certs
OIDC_AUDIENCE=hr-assistant
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
RATE_LIMIT_PER_MIN=20
# Leave empty to use the built-in mock HRMS; set to your real HRMS base URL later.
HRMS_BASE_URL=
